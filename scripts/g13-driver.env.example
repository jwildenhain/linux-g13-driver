# Environment for the G13 driver user service.
# Installed to ~/.config/g13/g13-driver.env by `g13ctl install`.
#
# systemd parses this file itself: no shell expansion, no `export`, and values
# containing spaces must be quoted.

# Absolute path to the built driver binary.
# `g13ctl install` rewrites this to point at your build.
G13_DRIVER_BIN=%REPO%/src/Linux-G13-Driver

# Seconds between polls while waiting for the G13 to be plugged in.
G13_WAIT_INTERVAL=2

# ---------------------------------------------------------------------------
# LCD LogiFrame page commands (lcd_logiframe_pageN_cmd in ~/.g13/bindings-N.properties)
# run via popen() and inherit this environment. A user service does NOT inherit
# your interactive shell's exports, so anything those commands need goes here.
# ---------------------------------------------------------------------------

# Steam friends page
#STEAM_API_KEY=
#STEAM_ID=

# Token usage page
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#GEMINI_USAGE_URL=
#ANTIGRAVITY_API_KEY=
#ANTIGRAVITY_USAGE_URL=
