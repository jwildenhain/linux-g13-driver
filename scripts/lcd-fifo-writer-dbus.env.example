# Absolute path to the DBus->LCD FIFO bridge script
SCRIPT_PATH=$HOME/.local/bin/lcd-fifo-writer-dbus.sh

# DBus connection and filter settings
DBUS_BUS=--session
DBUS_INTERFACE=com.jgtans.Lordbooker
DBUS_MEMBER=StatusUpdated
# Optional: override default interface/member match with a full dbus-monitor expression
# DBUS_MATCH=type='signal',interface='${DBUS_INTERFACE}',member='${DBUS_MEMBER}'

# FIFO path read by the Linux G13 driver in lcd_mode=fifo
LCD_FIFO=/tmp/g13_lcd_fifo
